{
  "name": "rumah-keripik-courier-capacitor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Rumah Keripik Courier App - Capacitor 7 (Vite + React + Tailwind CSS 4)",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "check:contrast": "tsx scripts/check-contrast.ts",
    "verify": "npm run typecheck && npm run check:contrast && npm run lint && npm run test && npm run build",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "cap:sync": "npm run build && cap sync",
    "cap:android": "cap open android",
    "cap:run": "npm run build && cap run android",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@capacitor-community/background-geolocation": "^1.2.26",
    "@capacitor-community/sqlite": "^7.0.0",
    "@capacitor-firebase/messaging": "^7.5.0",
    "@capacitor/android": "^7.6.8",
    "@capacitor/camera": "^7.0.0",
    "@capacitor/core": "^7.0.0",
    "@capacitor/geolocation": "^7.0.0",
    "@capacitor/haptics": "^7.0.0",
    "@capacitor/preferences": "^7.0.0",
    "@capgo/capacitor-updater": "^7.43.3",
    "@tanstack/react-query": "^5.62.0",
    "capacitor-secure-storage-plugin": "^0.12.0",
    "drizzle-orm": "^0.36.0",
    "lucide-react": "^0.469.0",
    "maplibre-gl": "^6.1.0",
    "prop-types": "^15.8.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-map-gl": "^8.1.2",
    "react-router-dom": "^7.1.0",
    "react-signature-canvas": "^1.0.4",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.0.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.0.0",
    "@testing-library/react": "^16.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/react-signature-canvas": "^1.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.17.0",
    "jsdom": "^25.0.1",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.23.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.0.0",
    "vitest": "^3.2.7"
  }
}
