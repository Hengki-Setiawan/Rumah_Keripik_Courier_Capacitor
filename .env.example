# ==== Rumah Keripik Courier (Capacitor) — Environment Variables ====
# Salin file ini menjadi `.env` dan isi nilainya. JANGAN commit `.env`.

# Base URL backend Next.js (rumah-kripik-web). Default mengarah ke produksi Vercel.
VITE_API_BASE_URL=https://rumah-keripik.vercel.app

# Peta rute memakai MapLibre GL JS (OpenStreetMap) — tanpa API key. Opsi berikut dibiarkan kosong.
VITE_GOOGLE_MAPS_API_KEY=

# VAPID key untuk web push (opsional — hanya relevan jika menjalankan FCM di web/dev).
VITE_FCM_VAPID_KEY=

# Opsional (live update Capgo) — set hanya jika pakai layanan Capgo.
# VITE_CAPGO_APP_ID=
# VITE_CAPGO_UPDATE_KEY=
